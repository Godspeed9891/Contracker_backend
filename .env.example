# Copy this file to .env and fill it in. Never commit .env.

# Your Postgres connection string (Neon, Render Postgres, or a local database)
DATABASE_URL=

# A long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET= 

# Only for a Postgres running on your own machine (no TLS). Leave out for Neon / Render.
# PGSSLMODE=disable

# Optional, defaults to 4000
# PORT=4000
# Set to 1 when the server sits behind a host's proxy (Render, Railway, Heroku...). Leave out on your own machine.
# TRUST_PROXY=1

# Set to off to switch login / sign-up rate limits off while testing. Leave out in production.
# RATE_LIMIT=off